// ============================================================================
// TekSolv AssetHub — Prisma schema
// Equipment inventory + rental + maintenance + safety inspections.
// PostgreSQL. Generate with `prisma migrate dev`.
//
// Hard rules this schema is shaped around (BUILD_SPEC §3):
//   1. `assetTag` is user-supplied / externally-sourced — NEVER auto-generated.
//      It is unique *per organization*, not globally.
//   2. Rental reservation integrity is enforced at the DB layer with a Postgres
//      GIST exclusion constraint (see migration 0002_reservation_integrity).
//   3. Custody is single-holder: an asset is in general stock, assigned to a
//      person, staged on a truck, or out on rent — never two at once. Modelled
//      as mutually-exclusive columns on Asset + CHECK constraints (migration
//      0003_custody_integrity) so the invariant cannot drift.
//   4. Status only changes inside a transaction that also writes the record
//      explaining why (Rental / MaintenanceTicket / Inspection).
//   5. Usage-based maintenance is *estimated* from rental days (priorUsage +
//      rentalDays × hoursPerDay) and is labelled as an estimate in the UI.
//
// Multi-tenancy (BUILD_SPEC §8): every tenant-scoped table carries `orgId`.
// Scoping is applied automatically by the Prisma client extension in
// src/lib/prisma.ts; RLS policies are available as defence in depth.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// TENANCY
// ===========================================================================

/// A tenant. TekSolv is simply org #1; the product is sold to other
/// rental/safety shops, each with its own assets, users, and NetSuite account.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  /// Free-form per-tenant settings (branding, default hoursPerDay, offices…).
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  netsuiteConfig  NetsuiteConfig?
  categories      Category[]
  locations       Location[]
  gasComponents   GasComponent[]
  fieldDefs       CustomFieldDefinition[]
  assets          Asset[]
  attachments     Attachment[]
  trucks          Truck[]
  custodyEvents   CustodyEvent[]
  customers       Customer[]
  jobs            Job[]
  rentals         Rental[]
  rentalOrders    RentalOrder[]
  consumables     Consumable[]
  consumableStock ConsumableStock[]
  consumableLots  ConsumableLot[]
  consumableTxns  ConsumableTxn[]
  schedules       MaintenanceSchedule[]
  records         MaintenanceRecord[]
  tickets         MaintenanceTicket[]
  templates       InspectionTemplate[]
  templateItems   InspectionTemplateItem[]
  inspections     Inspection[]
  responses       InspectionResponse[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  netsuiteRefs    NetsuiteRef[]
  netsuiteWrites  NetsuiteWrite[]
  containers      Container[]

  @@index([active])
}

enum Role {
  ADMIN // full control incl. user mgmt, templates, deletes
  MANAGER // supervisor: ops oversight, custody assignment, asset edits
  TECHNICIAN // field: grab, inspections, check-in
  VIEWER // read-only
}

/// A user's role *within* an organization. Users are global (one login, one
/// email); everything else about them is per-tenant. One membership per
/// (user, org) — the session resolves an active org from these.
model Membership {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   Role    @default(VIEWER)
  /// Worker-roster fields — the person as the floor knows them.
  title  String?
  phone  String?
  active Boolean @default(true)

  /// Which office this person works out of. A grab draws supplies from here,
  /// so that taking a box of gloves in Oakdale does not decrement Newark's
  /// shelf. Nullable: the roster predates it and a worker with none is asked
  /// which office at the moment they grab, rather than being blocked.
  homeLocationId String?
  homeLocation   Location? @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@index([orgId, active])
  @@index([orgId, homeLocationId])
}

// ===========================================================================
// AUTH & PEOPLE (global — NOT tenant-scoped)
// ===========================================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash for the credentials provider. Null for SSO-only users.
  passwordHash  String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts Account[]
  sessions Session[]

  memberships Membership[]

  // Domain relations
  rentalsRecorded    Rental[]            @relation("RecordedBy")
  checkoutsCreated   Rental[]            @relation("CheckedOutBy")
  checkinsProcessed  Rental[]            @relation("CheckedInBy")
  ordersRecorded     RentalOrder[]       @relation("OrderRecordedBy")
  ordersCheckedOut   RentalOrder[]       @relation("OrderCheckedOutBy")
  custodyOf          Asset[]             @relation("CustodyHolder")
  custodyAssigned    Asset[]             @relation("CustodyAssignedBy")
  netsuiteWrites     NetsuiteWrite[]     @relation("NetsuiteWriteBy")
  assetsRetired      Asset[]             @relation("RetiredBy")
  custodyEvents      CustodyEvent[]      @relation("CustodyEventActor")
  custodyEventsAbout CustodyEvent[]      @relation("CustodyEventHolder")
  trucksOwned        Truck[]             @relation("TruckOwner")
  consumableTxns     ConsumableTxn[]
  maintenanceRecords MaintenanceRecord[] @relation("PerformedBy")
  inspections        Inspection[]        @relation("Inspector")
  assignedTickets    MaintenanceTicket[] @relation("AssignedTo")
  uploads            Attachment[]        @relation("UploadedBy")
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([active])
}

// --- NextAuth adapter models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================================================
// TAXONOMY: CATEGORIES, LOCATIONS, CUSTOM FIELDS
// ===========================================================================

model Category {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  parentId String?
  parent   Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]   @relation("CategoryTree")

  assets              Asset[]
  fieldDefs           CustomFieldDefinition[]
  inspectionTemplates InspectionTemplate[]

  /// Default runtime-hours-per-rental-day for USAGE schedules on this category.
  hoursPerDay Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([orgId, slug])
  @@index([orgId, parentId])
}

enum LocationType {
  WAREHOUSE
  YARD
  OFFICE
  TRUCK
  JOBSITE
  VENDOR
  SERVICE_BAY
  OTHER
  /// A place rescue gear lives — the Rescue Prop, the Ops Manager Office.
  ///
  /// Not a building. These were typed OFFICE because that was the closest label
  /// available, which put them in the settings list beside Newark and Oakdale —
  /// real offices with a street address and nobody's rope in them. A rescue
  /// area is managed from Areas, holds kits, and never appears as a site.
  ///
  /// Appended, not inserted: Postgres enum values are ordered, and reordering
  /// them rewrites every row that references one.
  RESCUE_AREA
}

model Location {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name    String
  type    LocationType @default(WAREHOUSE)
  address String?
  active  Boolean      @default(true)

  assets        Asset[]
  /// Supplies held at this office, one row per item stocked here.
  stock         ConsumableStock[]
  lots          ConsumableLot[]
  txns          ConsumableTxn[]
  /// People whose home office this is — where their grabs draw stock from.
  members       Membership[]
  createdAt     DateTime          @default(now())
  containers    Container[]
  custodyOf     Asset[]           @relation("CustodyLocation")
  custodyEvents CustodyEvent[]    @relation("CustodyEventLocation")

  @@unique([orgId, name])
  @@index([orgId, type])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Admin-defined typed fields, optionally scoped to a category.
/// Values live in Asset.customFields (Json) keyed by `key`.
model CustomFieldDefinition {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  key        String
  label      String
  type       FieldType    @default(TEXT)
  options    Json? // choices for SELECT
  required   Boolean      @default(false)
  order      Int          @default(0)

  @@unique([orgId, categoryId, key])
  @@index([orgId])
}

// ===========================================================================
// TRUCKS (first-class: rescue / service fleet)
// ===========================================================================

/// Rescue & service trucks. Assets are *staged* on a truck (custody), which is
/// what the dashboard readiness panel reads. Some trucks permanently belong to
/// a named tech (TekSolv: 165/166/167).
/// A bag, box or kit that gear lives in — "George's Red Rigging Bag".
///
/// **A grouping *within* a holder, not a replacement for one.** The bag sits on
/// Truck 167; the gear in it is staged on Truck 167 too. Container membership
/// and custody are separate columns answering separate questions: which kit
/// does this belong to, and where is it right now.
///
/// That separation is what makes "incomplete" answerable without a manifest
/// table. Membership *is* the expectation — an item assigned to the bag is
/// supposed to be in the bag — and custody is the presence. An item whose
/// container is this bag but whose custody is somewhere else is missing from
/// it, and the app can say which item and why, using columns it already has.
/// The alternative, an expected-contents list maintained by hand, is a second
/// source of truth that goes stale the first time somebody forgets to update it.
model Container {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name  String
  notes String?

  /// Where the container itself lives. Exactly one of these, enforced by a
  /// CHECK constraint — a bag is on a truck or in a room, never both, and a
  /// bag that is nowhere is a bag nobody can go and fetch.
  truckId    String?
  truck      Truck?    @relation(fields: [truckId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  active Boolean @default(true)
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A bag's name is unique *within its holder*, not across the org — see the
  /// partial unique indexes in the migration. The office and the rescue yard
  /// are each entitled to keep a bag called "Harnesses", and org-wide
  /// uniqueness silently merged them into one bag with half its contents in
  /// another building, which then read incomplete forever.
  @@index([orgId, truckId])
  @@index([orgId, locationId])
}

model Truck {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      String // "165" — the number painted on the door
  /// Home office: Newark / Oakdale / Collinsville. Free text: per-tenant.
  office      String
  /// Permanent owner ("belongs to this tech at all times"), if any.
  ownerUserId String?
  owner       User?        @relation("TruckOwner", fields: [ownerUserId], references: [id])
  notes       String?
  active      Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stagedAssets  Asset[]        @relation("CustodyTruck")
  custodyEvents CustodyEvent[] @relation("CustodyEventTruck")
  containers    Container[]

  @@unique([orgId, number])
  @@index([orgId, office])
}

// ===========================================================================
// CORE: ASSETS
// ===========================================================================

enum AssetStatus {
  AVAILABLE
  OUT_ON_RENT
  IN_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
  /// Held pending a decision — a recall, a suspected defect, a post-incident
  /// hold, an expiry nobody can confirm.
  ///
  /// Its own value rather than an out-of-service with a reason, for a reason
  /// that is operational rather than tidy: the two **exit differently**.
  /// Out-of-service ends when somebody repairs the unit and returns it.
  /// Quarantine ends when somebody *decides* — and one of the decisions is
  /// "destroy it". Folding them together would put quarantined gear in the Out
  /// of Service list, where the standing "Return to service" button would clear
  /// a safety hold in one click, which is exactly what a hold exists to prevent.
  ///
  /// Appended, not inserted. Enum values are ordered by definition and putting
  /// this mid-list would rewrite the type.
  QUARANTINED
}

enum Condition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AttachmentType {
  PHOTO
  MANUAL
  CALIBRATION_CERT
  INSPECTION_PDF
  DOCUMENT
  SIGNATURE
}

/// Who is holding an asset right now. NONE is represented by a null
/// `custodyType`; OUT_ON_RENT is represented by status, not custody — the two
/// are mutually exclusive and a CHECK constraint enforces that.
enum CustodyType {
  PERSON
  TRUCK
  /// A named place that holds gear — "Ops Manager Office", "Rescue Prop".
  ///
  /// A *holder*, not a filing detail. It sits in the same exclusive set as a
  /// person and a truck: a unit is with somebody, on a vehicle, at a holder, in
  /// general stock, or out on rent — never two at once. Assignment writes a
  /// `CustodyEvent` exactly as the other two do, because "who had it last" has
  /// to answer the same way whichever kind of holder it was.
  ///
  /// Appended, not inserted: enum values are ordered by definition.
  LOCATION
}

/// What a unit is *for*, which is a different question from where it is or what
/// it is. RENTAL gear earns money and belongs in utilization; RESCUE gear is
/// standing capability — it lives on a truck waiting for a callout, and counting
/// it as idle rental stock would drag utilization down with equipment that was
/// never meant to go out on a ticket.
///
/// Deliberately orthogonal to custody: both kinds get staged on trucks, and a
/// truck's loadout is everything on it regardless of class.
/**
 * Why a unit left the fleet for good.
 * Distinct from `OUT_OF_SERVICE`, which is temporary: a unit in the shop is
 * coming back and is still capital the business owns and can deploy. A retired
 * unit is gone — and *why* it went matters, because "sold" and "damaged beyond
 * repair" are the same row in inventory but completely different facts about
 * how the fleet is being run.
 */
enum RetirementReason {
  SOLD
  SCRAPPED
  DAMAGED_BEYOND_REPAIR
  LOST
  OTHER
}

enum AssetType {
  RENTAL
  RESCUE
}

model Asset {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetTag String // REQUIRED, user-supplied, never auto-generated

  serialNumber String?
  manufacturer String?
  model        String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// When the unit was *made*, not bought. Distinct from purchaseDate and the
  /// one that drives service life on safety gear — a harness retires from its
  /// manufacture date, whatever date it was purchased. Entered in AssetHub;
  /// FAM has no equivalent, so the NetSuite sync never writes it.
  manufactureDate DateTime?
  /// When the unit first went to work — not when it was bought or made. Gear
  /// can sit in stores for a year, and inspection intervals run from here.
  /// Entered in AssetHub; FAM has no equivalent, so the sync never writes it.
  inServiceDate   DateTime?
  purchaseDate    DateTime?
  purchaseCost    Decimal?  @db.Decimal(12, 2)
  replacementCost Decimal?  @db.Decimal(12, 2) // drives "high-value out" reporting
  dailyRate       Decimal?  @db.Decimal(10, 2) // rental value / utilization math

  status    AssetStatus @default(AVAILABLE)
  condition Condition   @default(GOOD)
  /// RENTAL unless said otherwise — the overwhelming majority of the fleet, and
  /// the safe default: a mis-classified rental unit shows up in a report where
  /// somebody will notice it, whereas mis-classified rescue gear quietly skews
  /// utilization.
  assetType AssetType   @default(RENTAL)

  // --- Retirement -----------------------------------------------------------
  //
  // Set together, in one transaction, or not at all. `status = RETIRED` and
  // `active = false` are what every deployable query already filters on; these
  // three columns are what make the record *answerable* — what left the fleet,
  // when, why, and on whose say-so.
  //
  // `retiredAt` is not decoration: the utilization report ends a retired unit's
  // measurement window here, so a unit sold in June is measured over January to
  // June rather than being carried as idle capacity for the rest of the year.
  retiredAt     DateTime?
  retiredReason RetirementReason?
  retiredNote   String?
  retiredById   String?
  retiredBy     User?             @relation("RetiredBy", fields: [retiredById], references: [id])

  /// The kit this belongs to, if any.
  ///
  /// Independent of custody on purpose: the bag sits on Truck 167 and the gear
  /// in it is staged on Truck 167 too. Membership answers "which kit is this
  /// part of"; custody answers "where is it right now". Keeping them separate
  /// is what lets the app say a bag is short without a manifest table.
  containerId String?
  container   Container? @relation(fields: [containerId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // --- Custody (single-holder; see migration 0003) -------------------------
  custodyType         CustodyType?
  custodyUserId       String?
  custodyUser         User?        @relation("CustodyHolder", fields: [custodyUserId], references: [id])
  custodyTruckId      String?
  /// The holder-location this unit is assigned to, when `custodyType` is
  /// LOCATION. Distinct from `locationId`, which is where the unit *lives* in
  /// the catalogue sense — a unit can be catalogued at the warehouse and
  /// assigned to the Rescue Prop.
  custodyLocationId   String?
  custodyTruck        Truck?       @relation("CustodyTruck", fields: [custodyTruckId], references: [id])
  custodyLocation     Location?    @relation("CustodyLocation", fields: [custodyLocationId], references: [id])
  custodyAssignedById String?
  custodyAssignedBy   User?        @relation("CustodyAssignedBy", fields: [custodyAssignedById], references: [id])
  custodyAssignedAt   DateTime?

  customFields Json? // flexible blob validated against CustomFieldDefinition
  notes        String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments          Attachment[]
  rentals              Rental[]
  custodyEvents        CustodyEvent[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  inspections          Inspection[]
  tickets              MaintenanceTicket[]

  @@unique([orgId, assetTag])
  @@index([orgId, status])
  @@index([orgId, categoryId])
  @@index([orgId, locationId])
  @@index([orgId, serialNumber])
  @@index([orgId, custodyTruckId])
  @@index([orgId, custodyLocationId])
  @@index([orgId, custodyUserId])
  @@index([orgId, assetType])
  @@index([orgId, retiredAt])
  @@index([orgId, containerId])
}

/// Append-only custody history: who staged what, where, when.
model CustodyEvent {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Null = returned to general stock.
  type       CustodyType?
  userId     String?
  user       User?        @relation("CustodyEventHolder", fields: [userId], references: [id])
  truckId    String?
  truck      Truck?       @relation("CustodyEventTruck", fields: [truckId], references: [id])
  /// The holder-location, when `type` is LOCATION.
  locationId String?
  location   Location?    @relation("CustodyEventLocation", fields: [locationId], references: [id])

  actorId String
  actor   User    @relation("CustodyEventActor", fields: [actorId], references: [id])
  note    String?

  createdAt DateTime @default(now())

  @@index([orgId, assetId])
  @@index([orgId, createdAt])
}

model Attachment {
  id           String         @id @default(cuid())
  orgId        String
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type         AttachmentType
  url          String
  filename     String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?          @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([orgId, assetId])
}

// ===========================================================================
// RENTAL / CHECKOUT
// ===========================================================================

model Customer {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  email     String?
  phone     String?
  /// True for the synthetic "TekSolv (internal)" customer backing field grabs.
  internal  Boolean      @default(false)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  jobs         Job[]
  rentals      Rental[]
  rentalOrders RentalOrder[]

  @@index([orgId, name])
}

model Job {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  jobNumber   String?
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  siteAddress String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  rentals      Rental[]
  rentalOrders RentalOrder[]

  @@index([orgId, customerId])
  @@index([orgId, name])
}

enum RentalStatus {
  OPEN
  RETURNED
  OVERDUE
  CANCELLED
  /// A call-ahead booking: a future window, the unit still on the shelf
  /// (BUILD_SPEC §6.6). Holds the window for the GIST constraint exactly like
  /// OPEN does — which is the whole mechanism. Added last on purpose: enum
  /// values are ordered by definition, and inserting mid-list would rewrite
  /// the type.
  RESERVED
  /// The unit never came back. **Resolved, not open**: the line stops holding
  /// its reservation window and stops keeping the order open, because there is
  /// nothing left to wait for — the asset is retired and the loss is a charge,
  /// not an outstanding return. Distinct from RETURNED because a certificate,
  /// an invoice and a utilization figure all need to know the difference.
  LOST
}

/// CUSTOMER = a billable rental. INTERNAL = a field tech's self-checkout
/// ("grab") against the internal customer — same ledger, different intent.
enum RentalKind {
  CUSTOMER
  INTERNAL
}

/// Who physically took the unit off the shelf. COUNTER_PICKUP covers walk-in
/// credit-card pickups where no tech is involved.
enum CheckoutMethod {
  TECH
  COUNTER_PICKUP
}

/// A rental **order**: one customer, one job site, one due date, many assets.
///
/// Customers take several things at once, and before this each unit was its own
/// unrelated rental — four monitors on one truck meant four records with the
/// same customer typed four times, no way to return them together, and no
/// figure for what that job is holding.
///
/// **The order is a grouping over rentals, not a replacement for them.** Every
/// invariant stays where it was: custody and status remain per asset, and the
/// `rental_no_overlap` GIST constraint still refuses to double-book a unit —
/// that constraint lives on the line row and needs the line's own `assetId` and
/// `period`, which is why a line carries its own dates rather than reading the
/// order's.
///
/// The order is the authority for customer, job site and dates; lines carry
/// copies written by the one code path that creates them. That duplication is
/// forced by the constraint, not chosen — `verify:rental-orders` asserts every
/// line agrees with its order, so drift is caught rather than assumed away.
model RentalOrder {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind RentalKind @default(CUSTOMER)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  /// NetSuite sales-order number captured at checkout (the SO↔FAM link).
  orderNumber String?
  contactName String?
  /// Free-text destination for internal grabs ("Marcellus Pad 7").
  destination String?

  checkoutMethod CheckoutMethod @default(TECH)
  recordedById   String
  recordedBy     User           @relation("OrderRecordedBy", fields: [recordedById], references: [id])
  checkedOutById String?
  checkedOutBy   User?          @relation("OrderCheckedOutBy", fields: [checkedOutById], references: [id])

  checkoutDate       DateTime  @default(now())
  expectedReturnDate DateTime
  /// Stamped when the last line comes back. Null while anything is still out.
  closedAt           DateTime?

  notes String?

  lines Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, closedAt])
  @@index([orgId, customerId])
}

model Rental {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  /// The order this line belongs to. Every rental has one — a single-item
  /// checkout is an order with one line, so there is no second code path for
  /// the simple case and nothing that has to ask which shape it is looking at.
  orderId String
  order   RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind RentalKind @default(CUSTOMER)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  /// NetSuite sales-order number captured at checkout (the SO↔FAM link).
  orderNumber String?
  /// Customer-side contact on the ticket.
  contactName String?
  /// Free-text destination for internal grabs ("Marcellus Pad 7").
  destination String?

  /// Who entered the record (always a real logged-in user).
  recordedById String
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id])

  checkoutMethod CheckoutMethod @default(TECH)
  /// The tech who handed it out. Null for COUNTER_PICKUP.
  checkedOutById String?
  checkedOutBy   User?          @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  checkedInById  String?
  checkedInBy    User?          @relation("CheckedInBy", fields: [checkedInById], references: [id])

  checkoutDate       DateTime  @default(now())
  expectedReturnDate DateTime
  actualReturnDate   DateTime?

  checkoutCondition Condition  @default(GOOD)
  checkinCondition  Condition?

  /// A line whose unit never came back, and what it is worth to invoice.
  ///
  /// The flag and the amount are separate: a unit can be written off without
  /// being charged on (goodwill, a disputed loss, an internal grab), and an
  /// amount with no flag would read as a bill nobody agreed to send. The
  /// customer and the order are already reachable from `order`, so nothing
  /// about who to invoice is duplicated here.
  lostBillable    Boolean  @default(false)
  lostChargeAmount Decimal? @db.Decimal(12, 2)
  checkoutNotes     String?
  checkinNotes      String?

  status RentalStatus @default(OPEN)

  /// Stamped when a RESERVED window's start passes with the unit never picked
  /// up (BUILD_SPEC §6.6). Set by the notification cron, cleared on pickup —
  /// so a reservation collected two days late stops being flagged the moment
  /// it is converted.
  noShowAt DateTime?

  // Reservation window backing the GIST exclusion constraint.
  // Prisma can't model tstzrange natively; the constraint is created in
  // migration 0002_reservation_integrity (and widened to cover RESERVED in
  // 20260805120100_reservations). This range is set/cleared in the checkout,
  // check-in, and reservation server actions.
  period Unsupported("tstzrange")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, assetId])
  @@index([orgId, customerId])
  @@index([orgId, jobId])
  @@index([orgId, status])
  @@index([orgId, expectedReturnDate])
  // The reservation board reads forwards from today by start date — the other
  // end of the window from every index above.
  @@index([orgId, checkoutDate])
  @@index([orgId, orderNumber])
}

// ===========================================================================
// CONSUMABLES (counted stock — deliberately NOT Assets)
// ===========================================================================

/// A supply item. **Holds no count.** What is on the shelf is per office, in
/// `ConsumableStock`, and for lot-tracked items per lot underneath that — an
/// `onHand` column here would be a fleet-wide total that is true of nowhere
/// anybody actually stands.
/// A unit a concentration is measured in.
///
/// Three, because three is what appears on real cylinder labels: parts per
/// million for toxics, percent by volume for oxygen and simple mixtures, and
/// percent of the lower explosive limit for combustibles. They are not
/// convertible into one another — %LEL depends on which gas it is — so this is
/// a label, never a basis for arithmetic.
enum GasUnit {
  PPM
  PERCENT_VOL
  PERCENT_LEL
}

/// One gas inside a calibration cylinder.
///
/// `amount` is text, not a number, and deliberately so: labels read "2.5",
/// "20.9", "50" and occasionally something less tidy, and a certificate that
/// rewrote what the label says would be worse than one that copied it. The
/// *unit* is structured because that is the part that varies per component and
/// that a form has to print correctly.
model GasComponent {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  consumableId String
  consumable   Consumable @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  gas    String
  amount String
  unit   GasUnit

  /// The order they are printed in — the order somebody entered them, which on
  /// a cylinder label is the order they are read.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, consumableId])
}

model Consumable {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name   String
  sku    String?
  unit   String       @default("each") // "each", "box", "pair", "34L cyl"
  active Boolean      @default(true)

  /// Does this item come in dated lots? Gloves and safety glasses do not — they
  /// are a number on a shelf. Cal gas and P100 filters do: a cylinder has a
  /// number stamped on it and a date after which it must not be handed out,
  /// and a count alone cannot tell you which cylinder to reach for.
  lotTracked     Boolean @default(false)
  /// How many days before a lot expires the digest starts warning. Per item,
  /// because reordering cal gas takes longer than reordering filters.
  expiryLeadDays Int     @default(30)

  /// What is in the cylinder, for calibration gas — one row per component.
  ///
  /// This was a single `gasType` + `concentration` pair, which is only true of
  /// a single-gas cylinder. Most of what a shop actually calibrates with is a
  /// blend: a 4-gas is H2S, CO, O2 and LEL/CH4 together, each with its own
  /// number *and its own unit* — PPM for the toxics, % by volume for oxygen,
  /// % LEL for the combustible. One text box could only hold that by having
  /// somebody type all four into it, which is a list pretending to be a value
  /// and prints on a certificate as whatever they happened to type.
  ///
  /// Empty on everything that is not a gas: gloves have no components.
  gasComponents GasComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock ConsumableStock[]
  lots  ConsumableLot[]
  txns  ConsumableTxn[]

  @@unique([orgId, name])
  @@index([orgId, active])
}

/// What one office holds of one item.
///
/// The operational unit. "22 boxes of gloves" is not a fact anybody can act on
/// if 20 are in New Castle and 2 are in Oakdale and the crew asking is in
/// Oakdale — so the count, the reorder point, and the low-stock alert are all
/// per (item, office). The item's total is the sum of these, computed where a
/// total is genuinely what is wanted.
model ConsumableStock {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  consumableId String
  consumable   Consumable   @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Everything this office holds, expired lots included. What may actually be
  /// issued is this minus expired lots — derived, never stored, because a
  /// stored copy would go stale at midnight on an expiry date with nothing
  /// running to notice.
  onHand       Int  @default(0)
  /// Below this, this office is low. Per office: the warehouse carries a case
  /// and a satellite office carries two.
  reorderPoint Int?

  /// Digest claim, exactly as MaintenanceSchedule uses them — stamped when an
  /// alert goes out, cleared when a restock lifts the count back above the
  /// line, so "still low" does not re-announce on every run.
  alertedAt    DateTime?
  alertedState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, consumableId, locationId])
  @@index([orgId, locationId])
  @@index([orgId, consumableId])
}

/// A dated batch of a lot-tracked item, at one office.
///
/// Cal gas is the case that forces this to exist: an expired cylinder reads
/// exactly like a good one on a shelf and produces a calibration that says a
/// monitor is fine when it is not. So a lot carries its number and its date,
/// consumption takes the soonest-expiring first, and an expired lot stops
/// counting as stock that can be issued.
model ConsumableLot {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  consumableId String
  consumable   Consumable   @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// As stamped on the cylinder or printed on the box.
  lotNumber String
  /// Null for a lot that genuinely has no expiry. It is then simply stock that
  /// never goes off, and sorts last under FEFO.
  expiresAt DateTime?
  quantity  Int       @default(0)

  receivedAt DateTime @default(now())

  /// Digest claim — 'expiring' then 'expired', so each stage announces once.
  alertedAt    DateTime?
  alertedState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  txns ConsumableTxn[]

  @@unique([orgId, consumableId, locationId, lotNumber])
  @@index([orgId, consumableId, locationId])
  @@index([orgId, expiresAt])
}

enum ConsumableTxnReason {
  GRAB // a worker took supplies to a job
  RESTOCK
  ADJUSTMENT
  WASTE
  CALIBRATION // burned calibrating a unit, against a MaintenanceRecord
}

/// The consumable ledger. `qtyDelta` is negative when stock leaves.
/// onHand is maintained transactionally alongside these rows.
model ConsumableTxn {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  consumableId String
  consumable   Consumable   @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  /// Which office's shelf moved. Nullable only because rows written before
  /// stock became per-office cannot be assigned one honestly.
  locationId String?
  location   Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Which lot, for a lot-tracked item. This is the whole point of lots: a
  /// month later, "which cylinder did that calibration use" has an answer.
  lotId      String?
  lot        ConsumableLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  qtyDelta    Int
  reason      ConsumableTxnReason @default(GRAB)
  destination String?
  note        String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId, consumableId])
  @@index([orgId, createdAt])
  @@index([orgId, locationId])
}

// ===========================================================================
// MAINTENANCE, CALIBRATION, TICKETS
// ===========================================================================

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  CALIBRATION
  INSPECTION
  HYDROSTATIC
}

enum ScheduleBasis {
  CALENDAR // every N days from last performed
  TIME // fixed date (annual cert)
  USAGE // every N runtime hours, estimated from rental days
}

model MaintenanceSchedule {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Human label shown in the UI: "Annual flow test", "500-hour service".
  label String

  /// Set when this schedule is armed by completing an inspection, so the next
  /// inspection advances *this* row rather than adding another. Matching on the
  /// label instead would break the moment somebody renamed the template.
  inspectionTemplateId String?
  inspectionTemplate   InspectionTemplate? @relation(fields: [inspectionTemplateId], references: [id], onDelete: SetNull)

  type          MaintenanceType
  basis         ScheduleBasis   @default(CALENDAR)
  intervalDays  Int? // CALENDAR / TIME
  intervalUsage Int? // USAGE
  usageUnit     String?         @default("hours") // "hours", "cycles", "bump tests"

  // --- USAGE accrual (estimated — see BUILD_SPEC §6.4) ---------------------
  /// Hours banked at the last reset / manual adjustment.
  priorUsage    Decimal   @default(0) @db.Decimal(10, 2)
  /// Estimated runtime hours per rental day. Falls back to the category
  /// default, then to 8.
  hoursPerDay   Int?
  /// Rental days are counted from here forward when estimating usage.
  usageAnchorAt DateTime?

  lastPerformed DateTime?
  nextDue       DateTime?
  /// How many days before `nextDue` the "coming up" warning starts. Per
  /// schedule, because a monthly calibration and a five-year hydro need very
  /// different notice. For USAGE schedules it is converted to hours via
  /// `hoursPerDay` (BUILD_SPEC §6.4).
  leadDays      Int       @default(7)
  /// Stamped by the digest cron when this schedule was alerted on, cleared
  /// when service is logged or the reading is adjusted (BUILD_SPEC §6.4).
  /// Without it a schedule that stays overdue would re-alert on every run.
  alertedAt     DateTime?
  /// Which stage the last alert was for — 'soon' | 'due' | 'overdue'. Lets a
  /// schedule warn ahead of time *and* alert again when it actually falls due;
  /// `alertedAt` alone would suppress the second one.
  alertedState  String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  records MaintenanceRecord[]

  @@index([orgId, assetId])
  @@index([orgId, nextDue])
  @@index([orgId, basis])
  @@index([orgId, active, nextDue])
  @@index([orgId, inspectionTemplateId])
}

model MaintenanceRecord {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset        @relation(fields: [assetId], references: [id])

  scheduleId String?
  schedule   MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])

  type          MaintenanceType
  performedById String?
  performedBy   User?           @relation("PerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime        @default(now())

  workDone       String
  partsUsed      Json? // [{ name, qty, unitCost }]
  laborHours     Decimal? @db.Decimal(6, 2)
  cost           Decimal? @db.Decimal(12, 2)
  /// Meter reading at service, for USAGE schedules (estimated or actual).
  usageAtService Decimal? @db.Decimal(10, 2)

  /// Unguessable key for the public, read-only copy of this calibration report.
  ///
  /// The calibration sticker's QR points at `/c/<publicToken>`, and the sticker
  /// goes out on a monitor to a customer site — so the person who scans it is
  /// usually a safety officer with no login, and a link behind the session
  /// guard would land them on a sign-in page holding a gas detector. The token
  /// *is* the authorization: it grants read-only sight of one calibration and
  /// nothing else.
  ///
  /// Stored rather than derived from the id by HMAC, for a physical reason. The
  /// URL is printed on the label in text as well as in the code, so it has to
  /// be short enough to read and type — a signature over a 25-character cuid is
  /// not. A stored token is also revocable: one certificate's link can be
  /// rotated without touching any other.
  publicToken String? @unique
  /// What Form CAL-01 says, for a calibration. Null on every other kind of
  /// work — see `src/lib/cal01.ts` for the shape.
  ///
  /// A **snapshot**, deliberately, and the one place in this schema where that
  /// is the right answer. The printed report is a compliance record: it asserts
  /// that on this date this unit was calibrated with cylinder lot 4417-B
  /// expiring 2027-02-28, and the unit is next due on a date. Rendering those
  /// live would let a lot's expiry being corrected next month, or a schedule
  /// being re-intervalled, silently rewrite a document somebody already signed
  /// and filed. The lot ids are kept alongside the copied values so the ledger
  /// rows behind the consumption stay reachable.
  calibration Json?

  createdAt DateTime @default(now())

  @@index([orgId, assetId])
  @@index([orgId, performedAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MaintenanceTicket {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset        @relation(fields: [assetId], references: [id])

  title       String
  description String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  // Set when a failed inspection item auto-generates the ticket.
  sourceInspectionId String?
  sourceInspection   Inspection? @relation(fields: [sourceInspectionId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([orgId, assetId])
  @@index([orgId, status])
}

// ===========================================================================
// INSPECTIONS (safety-compliant, template-driven)
// ===========================================================================

enum ResponseType {
  PASS_FAIL
  YES_NO_NA
  TEXT
  NUMERIC
  PHOTO
}

enum InspectionResult {
  PASS
  FAIL
  PENDING
}

model InspectionTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  categoryId  String? // e.g. applies to "Gas Detection"
  category    Category?    @relation(fields: [categoryId], references: [id])
  version     Int          @default(1)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       InspectionTemplateItem[]
  inspections Inspection[]
  /// The recurring schedules this template arms. Completing an inspection
  /// advances one rather than creating a parallel reminder system.
  schedules   MaintenanceSchedule[]

  @@unique([orgId, slug])
  @@index([orgId, categoryId])
}

model InspectionTemplateItem {
  id                String             @id @default(cuid())
  orgId             String
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId        String
  template          InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label             String
  helpText          String?
  /// Optional heading this item sits under — "HARDWARE", "WEBBING". Null means
  /// an ungrouped list, which is what every flat template already is.
  section           String?
  responseType      ResponseType       @default(PASS_FAIL)
  required          Boolean            @default(true)
  order             Int                @default(0)
  /// "Critical": a FAIL here flips the asset OUT_OF_SERVICE and opens a ticket.
  failCreatesTicket Boolean            @default(true)

  responses InspectionResponse[]

  @@index([orgId, templateId])
  @@index([templateId, section, order])
}

model Inspection {
  id         String             @id @default(cuid())
  orgId      String
  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id])
  assetId    String
  asset      Asset              @relation(fields: [assetId], references: [id])

  inspectorId String
  inspector   User   @relation("Inspector", fields: [inspectorId], references: [id])

  result      InspectionResult @default(PENDING)
  performedAt DateTime         @default(now())

  /// How often this unit is inspected, in days, as the competent person set it
  /// at sign-off. Days rather than an enum so "every 45" needs no migration and
  /// so it drops straight into `MaintenanceSchedule.intervalDays`; the word the
  /// form prints ("Annual") is derived from the number.
  frequencyDays Int?
  /// When it is next due. Computed from `performedAt + frequencyDays` but
  /// stored, because the inspector can override it and the form must print what
  /// was decided. Null on a FAIL — a unit that failed has no next date, it has
  /// a ticket.
  nextDueAt     DateTime?

  latitude  Float?
  longitude Float?

  inspectorSignature String? // Attachment url or data URL
  customerSignature  String?
  customerName       String?
  pdfUrl             String?

  createdAt DateTime @default(now())

  responses InspectionResponse[]
  tickets   MaintenanceTicket[]

  @@index([orgId, assetId])
  @@index([orgId, templateId])
  @@index([orgId, result])
  @@index([orgId, performedAt])
}

model InspectionResponse {
  id           String                 @id @default(cuid())
  orgId        String
  org          Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspectionId String
  inspection   Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String
  item         InspectionTemplateItem @relation(fields: [itemId], references: [id])

  value    String? // "PASS"/"FAIL"/"YES"/"NO"/"NA"/free text/number
  passed   Boolean? // normalized for FAIL detection
  notes    String?
  photoUrl String?

  @@index([orgId, inspectionId])
}

// ===========================================================================
// NOTIFICATIONS & AUDIT
// ===========================================================================

enum NotificationType {
  MAINTENANCE_UPCOMING
  MAINTENANCE_OVERDUE
  CALIBRATION_DUE
  INSPECTION_DUE
  RENTAL_OVERDUE
  INSPECTION_FAILED
  EQUIPMENT_TAKEN // a worker grabbed gear / supplies
  /// A unit was assigned to a person, staged on a truck, or returned to
  /// general stock (BUILD_SPEC §6.2).
  CUSTODY_CHANGED
  TRUCK_NOT_READY
  GENERAL
  /// A reservation's start passed with the unit never collected (§6.6).
  RESERVATION_NO_SHOW
}

model Notification {
  id     String           @id @default(cuid())
  orgId  String
  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String?
  link   String?

  entityType String?
  entityId   String?

  read      Boolean   @default(false)
  emailedAt DateTime? // null = not yet emailed (drives the digest job)
  createdAt DateTime  @default(now())

  @@index([orgId, userId, read])
  @@index([orgId, emailedAt])
}

model AuditLog {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String?
  user   User?        @relation(fields: [userId], references: [id])

  action     String // "asset.checkout", "inspection.fail", "custody.assign"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, userId])
  @@index([orgId, createdAt])
}

// ===========================================================================
// NETSUITE BRIDGE (read-only; per-tenant credentials)
// ===========================================================================

/// Per-org NetSuite account + column ids. Each customer brings their own
/// account, so this cannot live in env once there is more than one tenant.
/// Secrets are written by an Admin and never returned to the client.
model NetsuiteConfig {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  enabled        Boolean @default(false)
  accountId      String?
  consumerKey    String?
  consumerSecret String?
  tokenId        String?
  tokenSecret    String?

  /// SO line column carrying the FAM unit ("Related Asset").
  rentalAssetColumn String? @default("custcol_ncfar_relatedasset")
  /// Optional rental-end date column.
  rentalEndColumn   String?
  /// Transaction status filter for "open" rentals.
  openStatusFilter  String? @default("SalesOrd:B")
  /// Local User id used to stamp synced rentals.
  syncUserId        String?

  lastSyncedAt DateTime?
  lastSyncLog  Json?

  // --- Write-back -----------------------------------------------------------
  //
  // The bridge is a *read* bridge with one narrow, opt-in exception. Every
  // field below defaults to the setting that sends nothing, so an org that
  // never touches this page can never write to NetSuite.

  /// What the one write path is allowed to do. See `NetsuiteWriteMode`.
  writeMode NetsuiteWriteMode @default(DISABLED)

  /// A second, separate key for production accounts.
  ///
  /// Deliberately not folded into `writeMode`. "Send" and "send to the
  /// production ledger" are different decisions made by different people at
  /// different times, and collapsing them into one enum value means the day
  /// somebody flips SEND on a sandbox they have also armed production for the
  /// moment credentials are swapped.
  allowProductionWrites Boolean @default(false)

  /// The FAM field AssetHub owns: whether the unit is out on a rental.
  ///
  /// No default, because it is account-specific and a guessed `custrecord_…`
  /// id would either 400 or, far worse, write to a real field that means
  /// something else. Unset = the path plans writes and refuses to send them.
  assetStatusField     String?
  /// What to write into that field at rental start / at return.
  assetStatusOnRent    String?
  assetStatusAvailable String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// How far the write path is allowed to go for one organization.
enum NetsuiteWriteMode {
  /// Nothing is planned and nothing is sent. The default, and where every
  /// organization stays until somebody deliberately moves it.
  DISABLED
  /// Build the exact payload, record it, send nothing. This is how a payload
  /// is validated against real data before anything reaches NetSuite.
  DRY_RUN
  /// Actually send. Still refused against a production account unless
  /// `allowProductionWrites` is separately true.
  SEND
}

enum NetsuiteWriteStatus {
  /// Dry run: the payload was built and recorded, nothing was sent.
  PLANNED
  /// Sent and acknowledged by NetSuite.
  SENT
  /// Sent and rejected, or the request failed. Retryable.
  FAILED
  /// A guard stopped it before it left the building. Not retryable without
  /// changing configuration — the detail says which guard and why.
  REFUSED
  /// The same transition had already been written. Nothing was sent again.
  DUPLICATE
}

/// Every write this app has ever attempted against NetSuite.
///
/// The whole ledger, not just failures: a bad write is only traceable and
/// reversible if the row that caused it recorded what went out, what came back,
/// who triggered it, and what the field held before. Dry runs are recorded the
/// same way, which is what makes DRY_RUN a real rehearsal rather than a
/// different code path.
model NetsuiteWrite {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The local transition that caused it — "rental.start" | "rental.end".
  trigger    String
  entityType String
  localId    String

  /// The external record being updated. Always resolved from a NetsuiteRef
  /// *before* any request is built: a write with no known external id is
  /// refused rather than turned into a create.
  netsuiteId   String?
  netsuiteType String

  /// One key per logical transition, so a double-fire is the same write.
  /// A partial unique index (see the migration) enforces at most one SENT row
  /// per key, while leaving failures retryable.
  idempotencyKey String

  mode   NetsuiteWriteMode
  status NetsuiteWriteStatus

  /// Exactly what would be, or was, sent — method, url, and body.
  request  Json
  /// What came back. Null for a dry run, which is the point of a dry run.
  response Json?
  /// What the owned fields held before the write, so it can be put back.
  previous Json?
  /// Why a write was refused, or how it failed.
  detail   String?

  attemptedById String?
  attemptedBy   User?   @relation("NetsuiteWriteBy", fields: [attemptedById], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, localId])
  @@index([orgId, idempotencyKey])
}

/// Maps a NetSuite internal id to a local record so syncs are idempotent.
model NetsuiteRef {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType   String // "Asset" | "Customer" | "Category" | "Rental"
  localId      String
  netsuiteId   String // NetSuite internal id
  netsuiteType String // "customrecord_ncfar_asset" | "customer" | "item"
  lastSyncedAt DateTime     @default(now())
  raw          Json? // last-seen NetSuite payload, for debugging/diffing

  @@unique([orgId, entityType, netsuiteId])
  @@index([orgId, localId])
}
